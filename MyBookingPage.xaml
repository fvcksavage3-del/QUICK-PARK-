<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="QuickPark.MyBookingPage"
    Title="My Booking"
    BackgroundColor="{StaticResource QuickParkPage}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Button
                Text="‹"
                FontSize="26"
                TextColor="#1A2430"
                BackgroundColor="White"
                WidthRequest="44"
                HeightRequest="44"
                CornerRadius="22"
                Padding="0"
                Clicked="BackButton_Clicked"
                SemanticProperties.Description="Back to dashboard" />
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Text="My Booking" FontSize="22" FontAttributes="Bold" TextColor="#151B24" />
                <Label Text="Your current reservation" FontSize="12" TextColor="#7B8490" />
            </VerticalStackLayout>
        </Grid>

        <ScrollView x:Name="ReservationContent" Grid.Row="1" IsVisible="False" Margin="0,24,0,0">
            <VerticalStackLayout Spacing="16">
                <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 22" Padding="18">
                    <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Current reservation" FontSize="16" FontAttributes="Bold" TextColor="#151B24" />
                        <Border x:Name="StatusBorder" Grid.Column="1" BackgroundColor="#FFF4DB" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="10,5">
                            <Label x:Name="StatusLabel" Text="Pending" FontSize="10" FontAttributes="Bold" TextColor="#9A6500" />
                        </Border>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#E9EDF1" />

                    <VerticalStackLayout Spacing="3">
                        <Label Text="Parking location" FontSize="11" TextColor="#7B8490" />
                        <Label x:Name="LocationLabel" FontSize="16" FontAttributes="Bold" TextColor="#151B24" />
                        <Label x:Name="LocationAddressLabel" FontSize="12" TextColor="#526579" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="14">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Date and time" FontSize="11" TextColor="#7B8490" />
                            <Label x:Name="DateTimeLabel" FontSize="13" FontAttributes="Bold" TextColor="#25364A" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Label Text="Parking slot" FontSize="11" TextColor="#7B8490" />
                            <Label x:Name="SlotLabel" FontSize="13" FontAttributes="Bold" TextColor="#25364A" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Spacing="3">
                            <Label Text="Parking fee" FontSize="11" TextColor="#7B8490" />
                            <Label x:Name="FeeLabel" FontSize="13" FontAttributes="Bold" TextColor="#25364A" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="3">
                            <Label Text="Reservation status" FontSize="11" TextColor="#7B8490" />
                            <Label x:Name="ReservationStatusLabel" FontSize="13" FontAttributes="Bold" TextColor="#23834B" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="2" Spacing="3">
                            <Label Text="Payment method" FontSize="11" TextColor="#7B8490" />
                            <Label x:Name="PaymentMethodLabel" FontSize="13" FontAttributes="Bold" TextColor="#25364A" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="3">
                            <Label Text="Payment status" FontSize="11" TextColor="#7B8490" />
                            <Label x:Name="PaymentStatusLabel" FontSize="12" FontAttributes="Bold" TextColor="#9A6500" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="3" Grid.ColumnSpan="2" Spacing="3">
                            <Label Text="Receipt / confirmation" FontSize="11" TextColor="#7B8490" />
                            <Label x:Name="ReceiptNumberLabel" FontSize="13" FontAttributes="Bold" TextColor="#25364A" />
                        </VerticalStackLayout>
                    </Grid>

                    <Button
                        x:Name="NavigateToParkingButton"
                        Text="Navigate to Parking"
                        Style="{StaticResource QuickParkPrimaryButton}"
                        HeightRequest="48"
                        CornerRadius="15"
                        IsEnabled="False"
                        Clicked="NavigateToParkingButton_Clicked" />
                    </VerticalStackLayout>
                </Border>

                <Label
                    Text="Reservation is stored in QuickPark. Payment is not processed by this app."
                    FontSize="11"
                    TextColor="#7B8490"
                    HorizontalTextAlignment="Center" />

                <Label
                    x:Name="CancellationPolicyLabel"
                    FontSize="11"
                    TextColor="#526579"
                    HorizontalTextAlignment="Center" />

                <Button
                    x:Name="CancelBookingButton"
                    Text="Cancel booking"
                    Style="{StaticResource QuickParkDangerButton}"
                    HeightRequest="48"
                    CornerRadius="24"
                    Clicked="CancelBookingButton_Clicked" />
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout x:Name="EmptyState" Grid.Row="1" Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
            <Label Text="No current reservation" FontSize="18" FontAttributes="Bold" TextColor="#25364A" HorizontalTextAlignment="Center" />
            <Label Text="Your active reservation will appear here." FontSize="13" TextColor="#7B8490" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <Label
            Grid.Row="2"
            Text="Payments remain unprocessed until a payment provider is connected."
            FontSize="10"
            TextColor="#929BA6"
            HorizontalTextAlignment="Center"
            Margin="0,12,0,4" />
    </Grid>
</ContentPage>
