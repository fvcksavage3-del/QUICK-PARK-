<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="QuickPark.ParkingLocationEditorPage"
    Title="Parking location"
    BackgroundColor="{StaticResource QuickParkPage}">

    <Grid RowDefinitions="Auto,*,Auto">
        <Grid Padding="20,14" ColumnDefinitions="Auto,*" ColumnSpacing="12" BackgroundColor="White">
            <Button
                Text="‹"
                Style="{StaticResource QuickParkSecondaryButton}"
                WidthRequest="46"
                HeightRequest="46"
                Padding="0"
                Clicked="BackButton_Clicked"
                SemanticProperties.Description="Cancel and return to admin dashboard" />
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label x:Name="PageTitleLabel" Text="Add parking location" FontSize="21" FontAttributes="Bold" TextColor="{StaticResource QuickParkText}" />
                <Label Text="Enter the details users will see when searching for parking." FontSize="12" TextColor="{StaticResource QuickParkMuted}" />
            </VerticalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout MaximumWidthRequest="760" HorizontalOptions="Center" Padding="18" Spacing="14">
                <Label
                    x:Name="StatusLabel"
                    IsVisible="False"
                    FontSize="13"
                    TextColor="{StaticResource QuickParkDanger}"
                    BackgroundColor="#FFF1F0"
                    Padding="12,10" />

                <Border Padding="18">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Location details" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource QuickParkText}" />
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Location name · Required" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource QuickParkMuted}" />
                            <Entry x:Name="NameEntry" Placeholder="e.g. QuickPark Central" MaxLength="100" ReturnType="Next" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Street address · Required" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource QuickParkMuted}" />
                            <Entry x:Name="AddressEntry" Placeholder="Building, street, city" MaxLength="200" ReturnType="Next" />
                            <Label
                                x:Name="AddressLookupLabel"
                                Text="Tap or drag the map pin to fill in the street address."
                                FontSize="11"
                                TextColor="{StaticResource QuickParkMuted}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Operating hours · Required" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource QuickParkMuted}" />
                            <Entry x:Name="HoursEntry" Placeholder="e.g. 24 hours or 6 AM - 11 PM" MaxLength="100" ReturnType="Next" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Hourly rate (PHP) · Required" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource QuickParkMuted}" />
                            <Entry x:Name="FeeEntry" Placeholder="0.00" Keyboard="Numeric" MaxLength="12" ReturnType="Next" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Total capacity · Required (1–400)" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource QuickParkMuted}" />
                            <Entry x:Name="CapacityEntry" Placeholder="e.g. 20" Keyboard="Numeric" MaxLength="3" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Parking area status · Required" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource QuickParkMuted}" />
                            <Picker x:Name="StatusPicker" Title="Select status">
                                <Picker.Items>
                                    <x:String>Active</x:String>
                                    <x:String>Inactive</x:String>
                                </Picker.Items>
                            </Picker>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Padding="18">
                    <VerticalStackLayout Spacing="11">
                        <Label Text="Map location" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource QuickParkText}" />
                        <Label Text="Choose the parking entrance on the map, use your current location, or enter coordinates manually. Internet access is needed to load the map." FontSize="12" TextColor="{StaticResource QuickParkMuted}" />
                        <Border Stroke="#D8E1EC" StrokeThickness="1" StrokeShape="RoundRectangle 12" HeightRequest="260">
                            <WebView
                                x:Name="LocationPickerMap"
                                Navigating="LocationPickerMap_Navigating"
                                Navigated="LocationPickerMap_Navigated"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill" />
                        </Border>
                        <Button
                            Text="Use my current location"
                            Clicked="UseCurrentLocationButton_Clicked"
                            Style="{StaticResource QuickParkSecondaryButton}"
                            HorizontalOptions="Start"
                            HeightRequest="38"
                            Padding="12,0" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="Latitude" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource QuickParkMuted}" />
                                <Entry x:Name="LatitudeEntry" Placeholder="-90 to 90" MaxLength="20" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="5">
                                <Label Text="Longitude" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource QuickParkMuted}" />
                                <Entry x:Name="LongitudeEntry" Placeholder="-180 to 180" MaxLength="20" />
                            </VerticalStackLayout>
                        </Grid>
                        <Button
                            Text="Show coordinates on map"
                            Clicked="ShowCoordinatesOnMapButton_Clicked"
                            Style="{StaticResource QuickParkSecondaryButton}"
                            HorizontalOptions="Start"
                            HeightRequest="38"
                            Padding="12,0" />
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="#EAF2FF" Stroke="#CFE0F5" Padding="14">
                    <Label Text="Capacity is created as real available parking slots when you save. Existing slots and reservation history are preserved when editing." FontSize="12" TextColor="{StaticResource QuickParkNavy}" />
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2" Padding="18,10,18,18" ColumnDefinitions="*,*" ColumnSpacing="10" BackgroundColor="White">
            <Button
                Text="Cancel"
                Style="{StaticResource QuickParkSecondaryButton}"
                Clicked="BackButton_Clicked" />
            <Button
                x:Name="SaveButton"
                Grid.Column="1"
                Text="Save location"
                Style="{StaticResource QuickParkPrimaryButton}"
                Clicked="SaveButton_Clicked" />
        </Grid>
        <ActivityIndicator
            x:Name="LoadingIndicator"
            Grid.RowSpan="3"
            IsVisible="False"
            IsRunning="False"
            Color="{StaticResource QuickParkBlue}"
            BackgroundColor="#660B1D38"
            HorizontalOptions="Center"
            VerticalOptions="Center" />
    </Grid>
</ContentPage>
