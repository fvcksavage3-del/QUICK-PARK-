<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="QuickPark.ReservationHistoryPage"
    Title="Parking history"
    BackgroundColor="{StaticResource QuickParkPage}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Button
                Text="‹"
                FontSize="26"
                TextColor="#1A2430"
                BackgroundColor="White"
                WidthRequest="44"
                HeightRequest="44"
                CornerRadius="22"
                Padding="0"
                Clicked="BackButton_Clicked"
                SemanticProperties.Description="Back to dashboard" />
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Text="Parking history" FontSize="22" FontAttributes="Bold" TextColor="#172E4E" />
                <Label Text="Your past and current reservation requests" FontSize="12" TextColor="#7B8DA4" />
            </VerticalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="10">
                <Label x:Name="HistoryStatusLabel" IsVisible="False" FontSize="12" TextColor="#B42318" />
                <VerticalStackLayout x:Name="HistoryItems" Spacing="10" />
                <Label
                    x:Name="EmptyHistoryLabel"
                    Text="No reservations found."
                    IsVisible="False"
                    FontSize="14"
                    TextColor="#7B8DA4"
                    HorizontalTextAlignment="Center"
                    Margin="8,32" />
            </VerticalStackLayout>
        </ScrollView>

        <Button
            x:Name="RefreshButton"
            Grid.Row="2"
            Text="Refresh history"
            Style="{StaticResource QuickParkPrimaryButton}"
            HeightRequest="44"
            Margin="0,12,0,0"
            CornerRadius="14"
            Clicked="RefreshButton_Clicked" />
    </Grid>
</ContentPage>
